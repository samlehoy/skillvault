{
  "name": "@samlehoy/skillvault",
  "version": "0.1.0",
  "description": "Local-first TUI for managing AI agent skills across agent IDEs.",
  "keywords": [
    "ai",
    "agent",
    "skills",
    "skill-management",
    "tui",
    "opencode",
    "antigravity",
    "claude-code",
    "codex"
  ],
  "license": "MIT",
  "author": "samlehoy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samlehoy/skillvault.git"
  },
  "homepage": "https://github.com/samlehoy/skillvault#readme",
  "type": "module",
  "bin": {
    "skillvault": "bin/skillvault.mjs"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc",
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "files": [
    "bin/",
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "ink": "^7.1.1",
    "react": "^19.2.8",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "ink-testing-library": "^4.0.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
